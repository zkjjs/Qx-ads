#!name=WeTalk 自动化签到+视频奖励
#!desc=打开 WeTalk 触发 queryBalanceAndBonus 抓取账号参数；每天 08:20 和 20:20 自动查询余额、签到并领取视频奖励。支持多账号。
#!author=TG@ZenMoFiShi / Loon适配 ChatGPT
#!homepage=https://github.com/ZenmoFeiShi/Qx
#!date=2026-05-11
#!system=iOS,iPadOS
#!loon_version=3.2.9

[Script]
http-request ^https:\/\/api\.wetalkapp\.com\/app\/queryBalanceAndBonus script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/WeTalk_Loon.js, timeout=30, tag=WeTalk获取账号参数
cron "20 8,20 * * *" script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/WeTalk_Loon.js, timeout=600, tag=WeTalk自动签到

[MITM]
hostname = api.wetalkapp.com
